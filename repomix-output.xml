            img.style.objectFit = 'cover';
            img.style.borderRadius = '4px';
            img.style.boxSizing = 'border-box';
          });
        });

        await Promise.all(bannerPromises);

        validBanners.sort((a, b) => a.name.localeCompare(b.name));

        validBanners.forEach(banner => {
