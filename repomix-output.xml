    box-shadow: var(--plug-smoothGlow-box-shadow0);
  }
  25% {
    box-shadow: var(--plug-smoothGlow-box-shadow25);
  }
  50% {
    box-shadow: var(--plug-smoothGlow-box-shadow50);
  }
