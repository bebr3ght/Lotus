                log_event(log, "mkoverlay done - keeping game frozen until runoverlay starts", "❄️")
                
        except subprocess.TimeoutExpired:
            log.error("[INJECT] mkoverlay timeout - monitor will auto-resume if needed")
            report_issue(
                "MKOVERLAY_TIMEOUT",
