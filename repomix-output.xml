    const resetDropdown = () => {
      // Remove active class to close dropdown
      modsDropdown.classList.remove("active");
      // Remove selected from all category options
      modsDropdown.querySelectorAll('lol-uikit-dropdown-option[value!=""]').forEach(opt => {
