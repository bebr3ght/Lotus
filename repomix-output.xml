  "No champions have custom skins yet.": "Ningún campeón tiene aspectos personalizados todavía.",
  "No champions found. Please ensure League of Legends client is running.": "No se han encontrado campeones. Asegúrate de que el cliente de League of Legends esté abierto.",
  "Select Skins & Chromas - {name}": "Elegir aspectos y cromas - {name}",
  "No skins found for this champion.": "No se han encontrado aspectos para este campeón.",
  "Skin {id}": "Aspecto {id}",
