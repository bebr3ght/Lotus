  transition: all 0.3s ease;
}
.pagination-button:hover:not(.disabled) {
  background-color: transparent;
  border: transparent;
  color: var(--plug-color-buttonHover);
  transform: scale(1.1);
}
.pagination-button.disabled {
  opacity: 0.5;
