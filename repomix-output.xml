    .peer-info {
      flex: 1;
      min-width: 0;
    }

    .peer-name {
      color: #a09b8c;
      font-family: var(--font-body), Arial, sans-serif;
      font-size: 12px;
      line-height: 16px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .peer-item:hover .peer-name {
      color: #f0e6d2;
    }

    .peer-status {
      font-family: var(--font-body), Arial, sans-serif;
      font-size: 10px;
