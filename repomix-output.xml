ICON_BIG = 1

LR_DEFAULTSIZE = 0x00000040
LR_LOADFROMFILE = 0x00000010
WS_EX_TRANSPARENT = 0x00000020
GWL_STYLE = -16
GWL_EXSTYLE = -20
