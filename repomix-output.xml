    .party-status.offline { color: #5b5a56; }
    .party-status.online  { color: #0acbe6; }
    .party-status.reconnecting { color: #c8aa6e; }

    /* Body — matches .lol-friend-finder-modal .modal-body */
    .party-content {
      display: flex;
