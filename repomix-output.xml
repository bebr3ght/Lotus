                        this.isChampionSelectActive = false;
                        this.enablePlugin();
                    }
                }
            });

            this.championSelectObserver.observe(document.body, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['style', 'class']
            });

