    .peers-list::-webkit-scrollbar { width: 6px; }
    .peers-list::-webkit-scrollbar-track { background: transparent; }
    .peers-list::-webkit-scrollbar-thumb { background: #463714; border-radius: 3px; }

    .peer-item {
      display: flex;
      align-items: center;
