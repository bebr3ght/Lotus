    text-shadow: var(--plug-soft-text-glow-kda1);
  }
  to {
    text-shadow: var(--plug-soft-text-glow-kda2);
  }
}

/* NOTE:
   Avoid hiding native League UI controls. This previously hid the profile skin-picker button
   which caused "missing buttons/text" reports when ROSE-Jade is enabled. */

.search-input {
  background-color: #21211f;
  border: var(--plug-search-input-border);
  border-radius: 13px;
