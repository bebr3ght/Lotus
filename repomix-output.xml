            {"errorTemplate": "Couldn't reach the party server: {error}", "errorValues": {"error": "timeout"}},
        )
        self.assertEqual(text_fields("message", "Party mode is not enabled"), {})


class LoadStringsTests(unittest.TestCase):
    def setUp(self):
