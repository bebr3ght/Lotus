    background-color: #423e28;
  }
  to {
    background-color: #fcfcd5;
  }
}

@keyframes ColorDownYellow {
  from {
    background-color: #fcfcd5;
  }
  to {
    background-color: #423e28;
  }
}

@keyframes logoGlow {
