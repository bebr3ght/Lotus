(function createCustomSkinSelector() {
  const LOG_PREFIX = "[ROSE-CustomSkinSelector]";
  const BUTTON_CLASS = "lu-custom-skin-button";
  const BUTTON_SELECTOR = `.${BUTTON_CLASS}`;
  const PANEL_CLASS = "lu-custom-skin-panel";
