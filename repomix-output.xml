        self.directory = Path(self._tmp.name)

    def tearDown(self):
        self._tmp.cleanup()

    def test_reads_the_language_file(self):
        (self.directory / "fr.json").write_text(
            json.dumps({"Save": "Enregistrer", "Empty": "", "Number": 3}), encoding="utf-8"
