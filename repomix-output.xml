  stopped = true;

  if (retryTimer) {
    clearTimeout(retryTimer);
    retryTimer = null;
  }

  monitoring = false;

  if (observer) {
    observer.disconnect();
    observer = null;
  }

  if (pollTimer) {
    clearInterval(pollTimer);
    pollTimer = null;
  }

