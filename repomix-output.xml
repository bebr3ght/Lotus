        pszContent=content,
        cButtons=2,
        pButtons=buttons,
        nDefaultButton=button_open,
        pszFooter=footer,
        pfCallback=None,
        cxWidth=240,
    )
    selected_button = wintypes.INT()

    callback_type = ctypes.WINFUNCTYPE(
        ctypes.c_long,
        wintypes.HWND,
        wintypes.UINT,
        wintypes.WPARAM,
        wintypes.LPARAM,
        wintypes.LPARAM,
    )

    def on_task_dialog_event(hwnd, notification, wparam, lparam, ref_data):
        if notification == 3:  # TDN_HYPERLINK_CLICKED
