                    bottom_right = wintypes.POINT(rect.right, rect.bottom)
                    user32.ScreenToClient(hwnd, ctypes.byref(top_left))
                    user32.ScreenToClient(hwnd, ctypes.byref(bottom_right))
                    user32.SetWindowPos(
