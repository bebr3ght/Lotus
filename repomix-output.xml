  const SPECIAL_CHROMA_SKIN_IDS = new Set([100001, 88888]); // 145071, 103086, 103087 removed - handled by ROSE-FormsWheel
  // HOL skins handled by ROSE-FormsWheel (should not show ChromaWheel buttons)
